# Copy to .env.local for local development; set Railway variables privately.
# App runtime: a least-privilege database role, never a browser-visible variable.
DATABASE_URL=postgresql://shopora_app:CHANGE_ME@127.0.0.1:5432/shopora
OWNED_AUTH_ENABLED=true
SHOPORA_BACKEND=postgres
AUTH_APP_ORIGIN=http://localhost:3000
AUTH_RATE_SECRET=
# Production AUTH_APP_ORIGIN=https://maketechlimited.com (exact origin, no slash).
# Migration-only owner connection: use one-off maintenance jobs, not the web app.
MIGRATION_DATABASE_URL=
# Email delivery credentials (not an authentication provider).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_REGION=US
ORDER_NOTIFICATION_EMAIL=
ORDER_REPLY_TO_EMAIL=
STORE_CURRENCY=NGN
NEXT_PUBLIC_STORE_CURRENCY=NGN
# Optional Google OAuth. Leave both empty to use email authentication only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=
